{
  "manifest_version": 3,
  "name": "LinkedIn Assist",
  "version": "1.0.0",
  "description": "Pre-fills personalized LinkedIn connection notes from a Google Sheet. You click Send.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LinkedIn Assist" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
